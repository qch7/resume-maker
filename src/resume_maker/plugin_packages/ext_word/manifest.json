{
  "manifest_version": 1,
  "id": "ext.word",
  "title": "Word 精确排版",
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugin_packages.ext_word.entry:activate"
    },
    "client": {
      "mode": "trusted-client",
      "entry": "bundled:plugin.js"
    }
  },
  "requires": {
    "host": {
      "documents": ">=1.0.0 <2.0.0",
      "resume_previews": ">=1.0.0 <2.0.0",
      "execution": ">=1.0.0 <2.0.0",
      "sandbox": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "word.renderer": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {
    "documents.previewers": [
      "ext.word/pages"
    ],
    "documents.renderers": [
      "ext.word/default"
    ],
    "documents.importers": [
      "ext.word/import"
    ]
  },
  "permissions": [
    "workspace.trusted"
  ],
  "dependencies": [
    "pymupdf>=1.25,<2"
  ],
  "enhances": []
}
