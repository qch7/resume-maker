{
  "manifest_version": 1,
  "id": "ext.ai-runtime",
  "title": "AI 编排",
  "capability_groups": [
    {
      "id": "ai",
      "title": "AI"
    }
  ],
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugin_packages.ext_ai_runtime.entry:activate"
    }
  },
  "requires": {
    "host": {
      "model.transport": ">=1.0.0 <2.0.0",
      "settings": ">=1.0.0 <2.0.0",
      "sandbox": ">=1.0.0 <2.0.0",
      "credentials": ">=1.0.0 <2.0.0",
      "execution": ">=1.0.0 <2.0.0",
      "activity": ">=1.0.0 <2.0.0",
      "privacy.gateway": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "provider": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {
    "http.routes": [
      "ext.ai-runtime/settings"
    ]
  },
  "permissions": [
    "workspace.trusted"
  ],
  "optional": {
    "ocr": ">=1.0.0 <2.0.0",
    "import.image": ">=1.0.0 <2.0.0"
  },
  "enhances": [
    "settings"
  ],
  "config": {
    "max_parallel_calls": 4,
    "max_waiting_calls": 32,
    "wait_timeout_seconds": 1200.0
  },
  "config_schema": {
    "additionalProperties": false,
    "description": "设置重建提供方实例，已有任务在旧配置下实际排空",
    "properties": {
      "max_parallel_calls": {
        "default": 4,
        "description": "模型实际调用并发数",
        "maximum": 32,
        "minimum": 1,
        "title": "Max Parallel Calls",
        "type": "integer"
      },
      "max_waiting_calls": {
        "default": 32,
        "description": "模型等待调用数",
        "maximum": 256,
        "minimum": 1,
        "title": "Max Waiting Calls",
        "type": "integer"
      },
      "wait_timeout_seconds": {
        "default": 1200,
        "description": "模型排队等待秒数",
        "maximum": 7200,
        "minimum": 1,
        "title": "Wait Timeout Seconds",
        "type": "number"
      }
    },
    "title": "Settings",
    "type": "object",
    "x-resume-maker-strict": true
  }
}
