{
  "manifest_version": 1,
  "id": "sys.assets",
  "title": "资源目录",
  "capability_groups": [
    {
      "id": "storage",
      "title": "资料存储"
    }
  ],
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugin_packages.sys_assets.entry:activate"
    }
  },
  "requires": {
    "host": {
      "db": ">=1.0.0 <2.0.0",
      "config": ">=1.0.0 <2.0.0",
      "assets.backend": ">=1.0.0 <2.0.0",
      "activity": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "assets": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {},
  "permissions": [
    "system.trusted"
  ],
  "data": {
    "settings": [
      "asset:",
      "asset-bundle:"
    ],
    "folders": [
      "assets"
    ]
  }
}
