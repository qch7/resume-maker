{
  "manifest_version": 1,
  "id": "sys.privacy",
  "title": "隐私保护",
  "capability_groups": [
    {
      "id": "privacy",
      "title": "隐私保护"
    }
  ],
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugin_packages.sys_privacy.entry:activate"
    }
  },
  "requires": {
    "host": {
      "db": ">=1.0.0 <2.0.0",
      "activity": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "privacy": {
        "version": "1.0.0",
        "cardinality": "one"
      },
      "privacy.store": {
        "version": "1.0.0",
        "cardinality": "one"
      },
      "privacy.gateway": {
        "version": "1.0.0"
      }
    }
  },
  "contributes": {
    "http.routes": [
      "sys.privacy/privacy"
    ]
  },
  "permissions": [
    "system.trusted"
  ],
  "consumes": [
    "privacy.rule_contributions"
  ],
  "data": {
    "settings": [
      "privacy_terms",
      "privacy_audit"
    ]
  }
}
