{
  "manifest_version": 1,
  "id": "sys.plugins",
  "title": "插件管理",
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugin_packages.sys_plugins.entry:activate"
    }
  },
  "requires": {
    "host": {
      "config": ">=1.0.0 <2.0.0",
      "db": ">=1.0.0 <2.0.0",
      "tasks": ">=1.0.0 <2.0.0",
      "execution": ">=1.0.0 <2.0.0",
      "sandbox": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "plugins": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {
    "http.routes": [
      "sys.plugins/plugins"
    ]
  },
  "permissions": [
    "system.trusted"
  ],
  "lifecycle": {
    "config_update": "host-restart"
  },
  "data": {
    "settings": [
      "plugins:"
    ]
  },
  "config": {
    "download_timeout_seconds": 5.0,
    "download_close_timeout_seconds": 10.0,
    "install_timeout_seconds": 300.0,
    "candidate_timeout_seconds": 120.0,
    "plan_lifetime_seconds": 600.0
  },
  "config_schema": {
    "additionalProperties": false,
    "description": "计划保留原有确认屏障，等待超时不会替代用户确认",
    "properties": {
      "download_timeout_seconds": {
        "default": 5,
        "description": "下载网络等待秒数",
        "maximum": 60,
        "minimum": 1,
        "title": "Download Timeout Seconds",
        "type": "number"
      },
      "download_close_timeout_seconds": {
        "default": 10,
        "description": "下载取消后的关闭等待秒数",
        "maximum": 120,
        "minimum": 1,
        "title": "Download Close Timeout Seconds",
        "type": "number"
      },
      "install_timeout_seconds": {
        "default": 300,
        "description": "离线安装秒数",
        "maximum": 1800,
        "minimum": 30,
        "title": "Install Timeout Seconds",
        "type": "number"
      },
      "candidate_timeout_seconds": {
        "default": 120,
        "description": "候选验收秒数",
        "maximum": 600,
        "minimum": 10,
        "title": "Candidate Timeout Seconds",
        "type": "number"
      },
      "plan_lifetime_seconds": {
        "default": 600,
        "description": "变更计划有效秒数",
        "maximum": 3600,
        "minimum": 60,
        "title": "Plan Lifetime Seconds",
        "type": "number"
      }
    },
    "title": "PluginPolicy",
    "type": "object",
    "x-resume-maker-strict": true
  }
}
