{
  "manifest_version": 1,
  "id": "sys.plugins",
  "title": "插件管理",
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugin_packages.sys_plugins.entry:activate"
    }
  },
  "requires": {
    "host": {
      "config": ">=1.0.0 <2.0.0",
      "db": ">=1.0.0 <2.0.0",
      "tasks": ">=1.0.0 <2.0.0",
      "execution": ">=1.0.0 <2.0.0",
      "sandbox": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "plugins": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {
    "http.routes": [
      "sys.plugins/plugins"
    ]
  },
  "permissions": [
    "system.trusted"
  ],
  "data": {
    "settings": [
      "plugins:"
    ]
  }
}
