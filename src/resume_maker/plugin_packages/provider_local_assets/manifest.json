{
  "manifest_version": 1,
  "id": "provider.local-assets",
  "title": "本地资源后端",
  "capability_groups": [
    {
      "id": "storage",
      "title": "资料存储"
    }
  ],
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugin_packages.provider_local_assets.entry:activate"
    }
  },
  "requires": {
    "host": {}
  },
  "provides": {
    "host": {
      "assets.backend": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {},
  "permissions": [
    "workspace.trusted"
  ]
}
