{
  "manifest_version": 1,
  "id": "sys.http",
  "title": "本机 HTTP",
  "capability_groups": [
    {
      "id": "workbench",
      "title": "工作台"
    }
  ],
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugin_packages.sys_http.entry:activate"
    }
  },
  "requires": {
    "host": {
      "config": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "http.client": {"version": "1.0.0", "cardinality": "one"},
      "http": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {
    "http.routes": [
      "sys.http/system"
    ]
  },
  "permissions": [
    "system.trusted"
  ]
}
