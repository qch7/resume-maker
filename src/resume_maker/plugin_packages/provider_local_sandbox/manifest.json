{
  "manifest_version": 1,
  "id": "provider.local-sandbox",
  "title": "本地材料会话",
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugin_packages.provider_local_sandbox.entry:activate"
    }
  },
  "requires": {
    "host": {}
  },
  "provides": {
    "host": {
      "sandbox.backend": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {},
  "permissions": [
    "workspace.trusted"
  ]
}
