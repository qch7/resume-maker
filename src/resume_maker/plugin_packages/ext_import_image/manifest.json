{
  "manifest_version": 1,
  "id": "ext.import-image",
  "version": "1.0.0",
  "package": "resume-maker",
  "title": "图片导入",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugin_packages.ext_import_image.entry:activate"
    }
  },
  "provides": {
    "host": {
      "import.image": {
        "version": "1.0.0"
      }
    }
  },
  "dependencies": [
    "pillow>=11,<13"
  ],
  "contributes": {
    "documents.importers": [
      "ext.import-image/default"
    ]
  }
}
