{
  "manifest_version": 1,
  "id": "ext.activity-ui",
  "title": "日志界面",
  "capability_groups": [
    {
      "id": "logs",
      "title": "日志"
    }
  ],
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "client": {
      "mode": "trusted-client",
      "entry": "bundled:plugin.js"
    }
  },
  "requires": {
    "host": {
      "activity": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {}
  },
  "contributes": {},
  "consumes": [
    "activity.presenters"
  ],
  "permissions": [
    "workspace.trusted"
  ]
}
