{
  "manifest_version": 1,
  "id": "sys.backup",
  "title": "备份恢复",
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugin_packages.sys_backup.entry:activate"
    }
  },
  "requires": {
    "host": {
      "db": ">=1.0.0 <2.0.0",
      "config": ">=1.0.0 <2.0.0",
      "assets": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "backup": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {
    "http.routes": [
      "sys.backup/system"
    ]
  },
  "permissions": [
    "system.trusted"
  ]
}
