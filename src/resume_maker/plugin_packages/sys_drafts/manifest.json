{
  "manifest_version": 1,
  "id": "sys.drafts",
  "title": "持久草稿",
  "capability_groups": [
    {
      "id": "storage",
      "title": "资料存储"
    }
  ],
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugin_packages.sys_drafts.entry:activate"
    }
  },
  "requires": {
    "host": {
      "db": ">=1.0.0 <2.0.0",
      "activity": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "workspace_storage": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {
    "http.routes": [
      "sys.drafts/workspace_storage"
    ]
  },
  "permissions": [
    "system.trusted"
  ],
  "data": {
    "settings": [
      "workspace-storage"
    ]
  }
}
