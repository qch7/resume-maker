{
  "manifest_version": 1,
  "id": "ext.honor-recognition",
  "title": "荣誉识别",
  "capability_groups": [
    {
      "id": "ocr",
      "title": "OCR 识别"
    },
    {
      "id": "ai",
      "title": "AI"
    },
    {
      "id": "honors",
      "title": "荣誉"
    }
  ],
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugin_packages.ext_honor_recognition.entry:activate"
    }
  },
  "requires": {
    "host": {
      "honors": ">=1.0.0 <2.0.0",
      "provider": ">=1.0.0 <2.0.0",
      "ocr": ">=1.0.0 <2.0.0",
      "tasks": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {}
  },
  "contributes": {
    "http.routes": [
      "ext.honor-recognition/honors"
    ]
  },
  "permissions": [
    "workspace.trusted"
  ],
  "enhances": [
    "honors"
  ]
}
