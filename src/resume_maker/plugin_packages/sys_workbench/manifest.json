{
  "manifest_version": 1,
  "id": "sys.workbench",
  "title": "工作台",
  "capability_groups": [
    {
      "id": "workbench",
      "title": "工作台"
    }
  ],
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugin_packages.sys_workbench.entry:activate"
    },
    "client": {
      "mode": "trusted-client",
      "entry": "bundled:plugin.js"
    }
  },
  "requires": {
    "host": {
      "catalog": ">=1.0.0 <2.0.0",
      "resume": ">=1.0.0 <2.0.0",
      "activity": ">=1.0.0 <2.0.0",
      "db": ">=1.0.0 <2.0.0",
      "settings": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "workspace": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {
    "commands": [
      "sys.workbench/manage-plugins"
    ],
    "http.routes": [
      "sys.workbench/system"
    ]
  },
  "permissions": [
    "system.trusted"
  ],
  "consumes": [
    "workspace.queries"
  ]
}
