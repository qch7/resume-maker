{
  "manifest_version": 1,
  "id": "sys.settings",
  "title": "系统设置",
  "capability_groups": [
    {
      "id": "workbench",
      "title": "工作台"
    }
  ],
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugin_packages.sys_settings.entry:activate"
    }
  },
  "requires": {
    "host": {
      "db": ">=1.0.0 <2.0.0",
      "activity": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "settings": {
        "version": "1.0.0",
        "cardinality": "one"
      },
      "config": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {
    "http.routes": [
      "sys.settings/settings"
    ]
  },
  "permissions": [
    "system.trusted"
  ],
  "data": {
    "tables": [
      "settings"
    ],
    "schemas": [
      "plugin_packages/sys_settings/data/sys.settings.sql"
    ]
  }
}
