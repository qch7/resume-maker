{
  "manifest_version": 1,
  "id": "sys.activity",
  "title": "系统日志",
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugin_packages.sys_activity.entry:activate"
    }
  },
  "requires": {
    "host": {
      "db": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "activity": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {
    "http.routes": [
      "sys.activity/activity"
    ]
  },
  "permissions": [
    "system.trusted"
  ],
  "data": {
    "settings": [
      "activity.preferences"
    ],
    "backup": false
  }
}
