{
  "manifest_version": 1,
  "id": "sys.docx",
  "title": "内置 DOCX 引擎",
  "capability_groups": [
    {
      "id": "documents",
      "title": "文档处理"
    }
  ],
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugin_packages.sys_docx.entry:activate"
    }
  },
  "requires": {
    "host": {}
  },
  "provides": {
    "host": {
      "docx": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {
    "documents.engines": [
      "sys.docx/default"
    ],
    "documents.importers": [
      "sys.docx/import"
    ]
  },
  "permissions": [
    "system.trusted"
  ]
}
