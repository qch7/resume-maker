{
  "manifest_version": 1,
  "id": "provider.rapidocr",
  "title": "RapidOCR",
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugin_packages.provider_rapidocr.entry:activate"
    }
  },
  "requires": {
    "host": {}
  },
  "provides": {
    "host": {
      "ocr.backend": {
        "version": "1.0.0",
        "cardinality": "one",
        "title": "文字识别引擎"
      }
    }
  },
  "contributes": {},
  "permissions": [
    "workspace.trusted"
  ],
  "dependencies": [
    "rapidocr-onnxruntime>=1.4,<2",
    "pillow>=11,<13",
    "pymupdf>=1.25,<2"
  ],
  "config": {
    "intra_op_num_threads": 2,
    "inter_op_num_threads": 1,
    "detection_side": 736,
    "base_side": 960,
    "retry_side": 2000,
    "text_score": 0.3,
    "adaptive_retry_enabled": true,
    "small_text_height": 14.0,
    "sparse_result_count": 2,
    "pdf_render_side": 2400,
    "pdf_render_scale": 3.0
  },
  "config_schema": {
    "additionalProperties": false,
    "description": "每个插件实例持有独立模型，重配置先等待当前识别结束",
    "properties": {
      "intra_op_num_threads": {
        "default": 2,
        "description": "算子内部 CPU 线程数",
        "maximum": 16,
        "minimum": 1,
        "title": "Intra Op Num Threads",
        "type": "integer"
      },
      "inter_op_num_threads": {
        "default": 1,
        "description": "算子之间 CPU 线程数",
        "maximum": 16,
        "minimum": 1,
        "title": "Inter Op Num Threads",
        "type": "integer"
      },
      "detection_side": {
        "default": 736,
        "description": "文本检测最长边像素数",
        "maximum": 4096,
        "minimum": 128,
        "title": "Detection Side",
        "type": "integer"
      },
      "base_side": {
        "default": 960,
        "description": "首次识别最长边像素数",
        "maximum": 2048,
        "minimum": 128,
        "title": "Base Side",
        "type": "integer"
      },
      "retry_side": {
        "default": 2000,
        "description": "复核识别最长边像素数",
        "maximum": 4096,
        "minimum": 256,
        "title": "Retry Side",
        "type": "integer"
      },
      "text_score": {
        "default": 0.3,
        "description": "引擎输出文字的最低置信度",
        "maximum": 1,
        "minimum": 0,
        "title": "Text Score",
        "type": "number"
      },
      "adaptive_retry_enabled": {
        "default": true,
        "description": "空白、稀疏或小字页复核一次",
        "title": "Adaptive Retry Enabled",
        "type": "boolean"
      },
      "small_text_height": {
        "default": 14,
        "description": "小字复核高度阈值像素数",
        "maximum": 64,
        "minimum": 0,
        "title": "Small Text Height",
        "type": "number"
      },
      "sparse_result_count": {
        "default": 2,
        "description": "稀疏文字复核行数阈值",
        "maximum": 20,
        "minimum": 0,
        "title": "Sparse Result Count",
        "type": "integer"
      },
      "pdf_render_side": {
        "default": 2400,
        "description": "PDF 栅格化最长边像素数",
        "maximum": 4096,
        "minimum": 512,
        "title": "Pdf Render Side",
        "type": "integer"
      },
      "pdf_render_scale": {
        "default": 3,
        "description": "PDF 栅格化最大倍率",
        "maximum": 4,
        "minimum": 1,
        "title": "Pdf Render Scale",
        "type": "number"
      }
    },
    "title": "Settings",
    "type": "object",
    "x-resume-maker-strict": true
  }
}
