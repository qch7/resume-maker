{
  "manifest_version": 1,
  "id": "sys.documents",
  "title": "文档流程",
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugin_packages.sys_documents.entry:activate"
    }
  },
  "requires": {
    "host": {
      "config": ">=1.0.0 <2.0.0",
      "docx": ">=1.0.0 <2.0.0",
      "assets": ">=1.0.0 <2.0.0",
      "activity": ">=1.0.0 <2.0.0",
      "resume": ">=1.0.0 <2.0.0",
      "db": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "documents": {
        "version": "1.0.0",
        "cardinality": "one"
      },
      "resume_previews": {
        "version": "1.0.0",
        "cardinality": "one"
      },
      "document.registry": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {
    "http.routes": [
      "sys.documents/resumes"
    ]
  },
  "permissions": [
    "system.trusted"
  ],
  "data": {
    "tables": [
      "exports"
    ],
    "folders": [
      "exports"
    ],
    "schemas": [
      "plugin_packages/sys_documents/data/sys.documents.sql"
    ]
  },
  "consumes": [
    "documents.importers"
  ]
}
