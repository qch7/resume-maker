{
  "manifest_version": 1,
  "id": "sys.documents",
  "title": "文档流程",
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugin_packages.sys_documents.entry:activate"
    }
  },
  "requires": {
    "host": {
      "config": ">=1.0.0 <2.0.0",
      "docx": ">=1.0.0 <2.0.0",
      "assets": ">=1.0.0 <2.0.0",
      "activity": ">=1.0.0 <2.0.0",
      "resume": ">=1.0.0 <2.0.0",
      "db": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "documents": {
        "version": "1.0.0",
        "cardinality": "one"
      },
      "resume_previews": {
        "version": "1.0.0",
        "cardinality": "one"
      },
      "document.registry": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {
    "http.routes": [
      "sys.documents/resumes"
    ]
  },
  "permissions": [
    "system.trusted"
  ],
  "data": {
    "tables": [
      "exports"
    ],
    "folders": [
      "exports"
    ],
    "schemas": [
      "plugin_packages/sys_documents/data/sys.documents.sql"
    ]
  },
  "consumes": [
    "documents.importers"
  ],
  "config": {
    "max_preview_requests": 16,
    "preview_timeout_seconds": 660.0,
    "failed_preview_retry_seconds": 2.0
  },
  "config_schema": {
    "additionalProperties": false,
    "description": "重建服务后使用新预算，已有渲染仍先实际排空",
    "properties": {
      "max_preview_requests": {
        "default": 16,
        "description": "预览执行及等待总数",
        "maximum": 128,
        "minimum": 1,
        "title": "Max Preview Requests",
        "type": "integer"
      },
      "preview_timeout_seconds": {
        "default": 660,
        "description": "预览排队及全部生成阶段的总秒数",
        "maximum": 3600,
        "minimum": 5,
        "title": "Preview Timeout Seconds",
        "type": "number"
      },
      "failed_preview_retry_seconds": {
        "default": 2,
        "description": "相同输入预览失败的自动重试间隔",
        "maximum": 30,
        "minimum": 0,
        "title": "Failed Preview Retry Seconds",
        "type": "number"
      }
    },
    "title": "Settings",
    "type": "object",
    "x-resume-maker-strict": true
  }
}
