{
  "manifest_version": 1,
  "id": "ext.template-ai",
  "title": "AI 模板分析",
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugin_packages.ext_template_ai.entry:activate"
    }
  },
  "requires": {
    "host": {
      "templates": ">=1.0.0 <2.0.0",
      "provider": ">=1.0.0 <2.0.0",
      "tasks": ">=1.0.0 <2.0.0"
    }
  },
  "optional": {
    "word.renderer": ">=1.0.0 <2.0.0"
  },
  "provides": {
    "host": {}
  },
  "contributes": {
    "http.routes": [
      "ext.template-ai/templates"
    ]
  },
  "permissions": [
    "workspace.trusted"
  ],
  "enhances": [
    "templates"
  ]
}
