{
  "manifest_version": 1,
  "id": "ext.ai-conversation",
  "title": "AI 会话",
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugins.features:conversations"
    },
    "client": {
      "mode": "trusted-client",
      "entry": "builtin:features/conversations/plugin.ts"
    }
  },
  "requires": {
    "host": {
      "db": ">=1.0.0 <2.0.0",
      "catalog": ">=1.0.0 <2.0.0",
      "provider": ">=1.0.0 <2.0.0",
      "config": ">=1.0.0 <2.0.0",
      "tasks": ">=1.0.0 <2.0.0",
      "activity": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "conversations": {
        "version": "1.0.0",
        "cardinality": "one"
      },
      "jobs": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {
    "workspace.queries": [
      "conversations"
    ],
    "http.routes": [
      "ext.ai-conversation/conversations",
      "ext.ai-conversation/jobs"
    ]
  },
  "permissions": [
    "workspace.trusted"
  ],
  "data": {
    "tables": [
      "conversations",
      "messages",
      "proposals",
      "jobs",
      "events"
    ],
    "schemas": [
      "infrastructure/schemas/ext.ai-conversation.sql"
    ],
    "relations": [
      "infrastructure/schemas/ext.ai-conversation.references.sql"
    ]
  },
  "enhances": [
    "catalog"
  ],
  "optional": {
    "sources": ">=1.0.0 <2.0.0"
  }
}
