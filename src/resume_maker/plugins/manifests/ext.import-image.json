{
  "manifest_version": 1,
  "id": "ext.import-image",
  "version": "1.0.0",
  "package": "resume-maker",
  "title": "图片导入",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugins.providers:import_image"
    }
  },
  "provides": {
    "host": {
      "import.image": {
        "version": "1.0.0"
      }
    }
  },
  "dependencies": [
    "pillow>=11,<13"
  ]
}
