{
  "manifest_version": 1,
  "id": "sys.execution",
  "title": "系统执行",
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugins.system:execution"
    }
  },
  "requires": {
    "host": {
      "execution.backend": ">=1.0.0 <2.0.0",
      "activity": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "execution": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {},
  "permissions": [
    "system.trusted"
  ]
}
