{
  "manifest_version": 1,
  "id": "ext.provider-codex",
  "title": "Codex 适配器",
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugins.providers:codex"
    },
    "client": {
      "mode": "trusted-client",
      "entry": "builtin:features/providers/plugin.ts"
    }
  },
  "requires": {
    "host": {
      "sandbox": ">=1.0.0 <2.0.0",
      "execution": ">=1.0.0 <2.0.0",
      "credentials": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "model.transport": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {},
  "permissions": [
    "workspace.trusted"
  ]
}
