{
  "manifest_version": 1,
  "id": "ext.import-pdf",
  "version": "1.0.0",
  "package": "resume-maker",
  "title": "PDF 导入",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugins.providers:import_pdf"
    }
  },
  "provides": {
    "host": {
      "import.pdf": {
        "version": "1.0.0"
      }
    }
  },
  "dependencies": [
    "pymupdf>=1.25,<2",
    "pdf2docx>=0.5.8,<0.6",
    "pillow>=11,<13"
  ],
  "contributes": {
    "documents.importers": [
      "ext.import-pdf/default",
      "ext.import-pdf/scanned-docx"
    ]
  }
}
