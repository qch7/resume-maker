{
  "manifest_version": 1,
  "id": "sys.experience",
  "title": "经历与版本",
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugins.system:experience"
    }
  },
  "requires": {
    "host": {
      "db": ">=1.0.0 <2.0.0",
      "activity": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "catalog": {
        "version": "1.0.0",
        "cardinality": "one"
      },
      "projects": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {
    "http.routes": [
      "sys.experience/projects"
    ]
  },
  "permissions": [
    "system.trusted"
  ],
  "data": {
    "tables": [
      "projects",
      "revisions",
      "drafts",
      "experience_branches",
      "revision_branches",
      "project_hierarchy",
      "snapshots"
    ],
    "folders": [
      "snapshots"
    ]
  }
}
