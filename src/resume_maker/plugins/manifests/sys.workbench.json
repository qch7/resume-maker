{
  "manifest_version": 1,
  "id": "sys.workbench",
  "title": "工作台",
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugins.system:workbench"
    },
    "client": {
      "mode": "trusted-client",
      "entry": "builtin:app/plugin.ts"
    }
  },
  "requires": {
    "host": {
      "catalog": ">=1.0.0 <2.0.0",
      "activity": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "workspace": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {
    "commands": ["sys.workbench/manage-plugins"],
    "http.routes": [
      "sys.workbench/system"
    ]
  },
  "permissions": [
    "system.trusted"
  ]
}
