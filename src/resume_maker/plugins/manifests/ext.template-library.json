{
  "manifest_version": 1,
  "id": "ext.template-library",
  "title": "模板库",
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugins.features:template_library"
    }
  },
  "requires": {
    "host": {
      "config": ">=1.0.0 <2.0.0",
      "templates": ">=1.0.0 <2.0.0",
      "resume_previews": ">=1.0.0 <2.0.0",
      "activity": ">=1.0.0 <2.0.0",
      "resume": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "template_library": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {
    "workspace.queries": [
      "templates"
    ],
    "http.routes": [
      "ext.template-library/templates"
    ]
  },
  "permissions": [
    "workspace.trusted"
  ],
  "data": {
    "settings": [
      "template_library"
    ]
  },
  "enhances": []
}
