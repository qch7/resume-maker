{
  "manifest_version": 1,
  "id": "sys.resume",
  "title": "简历编排",
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugins.system:resume"
    },
    "client": {
      "mode": "trusted-client",
      "entry": "builtin:features/resumes/plugin.ts"
    }
  },
  "requires": {
    "host": {
      "db": ">=1.0.0 <2.0.0",
      "catalog": ">=1.0.0 <2.0.0",
      "assets": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "resume": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {
    "documents.previewers": [
      "sys.resume/content"
    ],
    "http.routes": [
      "sys.resume/resumes"
    ]
  },
  "permissions": [
    "system.trusted"
  ],
  "consumes": [
    "resume.sources",
    "documents.previewers"
  ],
  "data": {
    "tables": [
      "resumes",
      "resume_deletions"
    ],
    "schemas": [
      "infrastructure/schemas/sys.resume.sql"
    ],
    "relations": [
      "infrastructure/schemas/sys.resume.references.sql"
    ]
  }
}
