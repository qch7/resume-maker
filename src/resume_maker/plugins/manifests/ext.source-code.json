{
  "manifest_version": 1,
  "id": "ext.source-code",
  "title": "源码资料",
  "version": "1.0.0",
  "package": "resume-maker",
  "entrypoints": {
    "host": {
      "mode": "trusted-host",
      "entry": "resume_maker.plugins.features:source_code"
    },
    "client": {
      "mode": "trusted-client",
      "entry": "builtin:features/sources/plugin.ts"
    }
  },
  "requires": {
    "host": {
      "catalog": ">=1.0.0 <2.0.0",
      "projects": ">=1.0.0 <2.0.0",
      "sandbox": ">=1.0.0 <2.0.0"
    }
  },
  "provides": {
    "host": {
      "sources": {
        "version": "1.0.0",
        "cardinality": "one"
      }
    }
  },
  "contributes": {
    "http.routes": [
      "ext.source-code/projects"
    ]
  },
  "permissions": [
    "workspace.trusted"
  ]
}
