# 复制为源码根目录 .env，或用 --env-file 指定位置
# 优先级：命令行 > 进程环境 > 此文件 > 默认值
RESUME_MAKER_PORT=8765
# 留空沿用产品默认资料目录，文件中的相对路径以此文件所在目录为基准
RESUME_MAKER_DATA_DIR=
# 留空使用安装包内资源或源码 frontend/dist
RESUME_MAKER_FRONTEND_DIR=
# 留空沿用已保存的插件选择，可显式填写 minimal 或 standard
RESUME_MAKER_PROFILE=
# OCR、Word、任务、SQLite、日志、下载和模板策略见 examples/plugin-config.json
# 需要调整时填写文件路径，例如 ./examples/plugin-config.json；完整字段见 docs/reference/plugin-settings.md
RESUME_MAKER_PLUGIN_CONFIG=
RESUME_MAKER_OPEN_BROWSER=true
# 宿主就绪等待、候选健康观察和健康检查间隔，单位均为秒
RESUME_MAKER_STARTUP_TIMEOUT_SECONDS=120
RESUME_MAKER_HEALTH_OBSERVATION_SECONDS=3
RESUME_MAKER_HEALTH_POLL_SECONDS=0.5
