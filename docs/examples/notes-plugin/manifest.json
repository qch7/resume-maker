{
  "manifest_version": 1,
  "id": "community.notes",
  "title": "独立笔记示例",
  "version": "1.0.0",
  "package": "community.notes",
  "instances": { "multiple": true },
  "entrypoints": {
    "host": { "mode": "trusted-host", "entry": "python/plugin.py:activate" },
    "client": { "mode": "trusted-client", "entry": "client/index.js" }
  },
  "requires": { "host": { "storage.instances": ">=1.0.0 <2.0.0" } },
  "contributes": {
    "workspace.queries": ["community.notes/summary"],
    "pages": ["community.notes/main"]
  },
  "config": { "title": "我的笔记" },
  "config_schema": {
    "type": "object",
    "properties": { "title": { "type": "string" } },
    "required": ["title"],
    "additionalProperties": false
  },
  "rpc": {
    "read": { "input_schema": { "type": "null" }, "output_schema": { "type": "string" } },
    "save": { "input_schema": { "type": "string", "maxLength": 2000 }, "output_schema": { "type": "string" } }
  },
  "permissions": ["workspace.trusted"]
}
